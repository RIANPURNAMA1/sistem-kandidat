generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  AFFILIATE
  KANDIDAT
  GURU
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum MaritalStatus {
  BELUM_MENIKAH
  MENIKAH
  CERAI
}

enum BloodType {
  A
  B
  AB
  O
}

enum ProgramStatus {
  AKTIF
  NONAKTIF
  PENUH
  SELESAI
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
  WAITING_PAYMENT
  PAID
  TRAINING
  PLACED
  COMPLETED
}

enum PaymentStatus {
  MENUNGGU_UPLOAD
  MENUNGGU_VERIFIKASI
  VALID
  DITOLAK
}

enum DocumentType {
  KTP
  KK
  PASPOR
  IJAZAH
  CV
  SERTIFIKAT
  LAINNYA
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  UPLOAD
  DOWNLOAD
  VIEW
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  password     String
  role         Role      @default(KANDIDAT)
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  candidate    Candidate?
  affiliate    Affiliate?
  auditLogs    AuditLog[]
  notifications Notification[]
  memberAreaMembers MemberAreaMember[] @relation("MemberAreaMemberUser")
  memberAreaInvites  MemberAreaMember[] @relation("MemberAreaMemberInviter")
  memberAreaPosts    MemberAreaPost[]
  memberAreaComments MemberAreaComment[]
  memberAreaReactions MemberAreaReaction[]
  memberAreaFiles    MemberAreaFile[]
  lmsEnrollments     CourseEnrollment[]
  lmsTeaching        CourseEnrollment[] @relation("GuruEnrollment")
  lmsGradedSubmissions AssignmentSubmission[] @relation("GradedBy")

  @@map("users")
}

model OtpCode {
  id        String    @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("otp_codes")
}

model Candidate {
  id               String         @id @default(uuid())
  userId           String         @unique
  nik              String         @unique
  fullName         String
  birthPlace       String
  birthDate        DateTime
  gender           Gender
  maritalStatus    MaritalStatus
  address          String         @db.Text
  kampung          String?
  desa             String?
  kecamatan        String
  kabupaten        String
  provinsi         String
  lastEducation    String
  graduationYear   Int?
  height           Float?
  weight           Float?
  bloodType        BloodType?
  clothingSize     String?
  phone            String
  guardianName     String?
  guardianPhone    String?
  fatherOccupation String?
  motherOccupation String?
  childOrder       Int?
  totalSiblings    Int?
  referredBy       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliate        Affiliate?     @relation(fields: [referredBy], references: [code])
  documents        Document[]
  applications     Application[]
  payments         Payment[]
  followUpLogs     FollowUpLog[]

  @@map("candidates")
}

model Program {
  id                  String          @id @default(uuid())
  name                String
  slug                String          @unique
  categoryId          String
  description         String          @db.LongText
  requirements        String          @db.Text
  benefits            String?         @db.Text
  quota               Int
  startDate           DateTime?
  endDate             DateTime?
  fee                 Decimal         @db.Decimal(15, 2)
  affiliateCommission Decimal         @db.Decimal(15, 2)
  commissionType      String          @default("FIXED")
  country             String?
  duration            String?
  status              ProgramStatus   @default(AKTIF)
  thumbnailUrl        String?
  isFeatured          Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  category     ProgramCategory @relation(fields: [categoryId], references: [id])
  applications Application[]
  affiliates   AffiliateProgram[]
  coupons      Coupon[]

  @@map("programs")
}

model ProgramCategory {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  icon      String?
  programs  Program[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("program_categories")
}

model Application {
  id            String            @id @default(uuid())
  candidateId   String
  programId     String
  status        ApplicationStatus @default(SUBMITTED)
  notes         String?           @db.Text
  adminNotes    String?           @db.Text
  submittedAt   DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  candidate     Candidate         @relation(fields: [candidateId], references: [id])
  program       Program           @relation(fields: [programId], references: [id])
  payment       Payment?
  statusHistory ApplicationHistory[]

  @@unique([candidateId, programId])
  @@map("applications")
}

model ApplicationHistory {
  id            String            @id @default(uuid())
  applicationId String
  status        ApplicationStatus
  notes         String?
  changedBy     String?
  createdAt     DateTime          @default(now())

  application   Application @relation(fields: [applicationId], references: [id])

  @@map("application_histories")
}

model Document {
  id          String         @id @default(uuid())
  candidateId String
  type        DocumentType
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  status      DocumentStatus @default(PENDING)
  adminNotes  String?
  verifiedAt  DateTime?
  verifiedBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@map("documents")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String    @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue Decimal   @db.Decimal(15, 2)
  programId     String?
  maxUses       Int       @default(0)
  usedCount     Int       @default(0)
  minPayment    Decimal   @db.Decimal(15, 2) @default(0)
  maxDiscount   Decimal?  @db.Decimal(15, 2)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  program       Program?  @relation(fields: [programId], references: [id])

  @@map("coupons")
}

model Payment {
  id              String        @id @default(uuid())
  applicationId   String        @unique
  candidateId     String
  amount          Decimal       @db.Decimal(15, 2)
  status          PaymentStatus @default(MENUNGGU_UPLOAD)
  proofUrl        String?
  uploadedAt      DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectedReason  String?       @db.Text
  ocrData         Json?
  ocrConfidence   Float?
  bankFrom        String?
  bankTo          String?
  senderName      String?
  referenceNumber String?
  receiverName    String?
  transferDate    DateTime?
  couponCode      String?
  discountAmount  Decimal       @db.Decimal(15, 2) @default(0)
  originalAmount  Decimal?      @db.Decimal(15, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
  candidate   Candidate   @relation(fields: [candidateId], references: [id])
  commission  Commission?

  @@map("payments")
}

model Affiliate {
  id                 String   @id @default(uuid())
  userId             String   @unique
  code               String   @unique
  name               String?
  referralLink       String?
  qrCode             String?
  bankName           String?
  bankAccount        String?
  bankHolder         String?
  isActive           Boolean  @default(true)
  totalClicks        Int      @default(0)
  totalRegistrations Int      @default(0)
  totalPaid          Int      @default(0)
  totalCommission    Decimal  @db.Decimal(15, 2) @default(0)
  points             Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   Candidate[]
  clickLogs   AffiliateClick[]
  commissions Commission[]
  withdrawals Withdrawal[]
  programs    AffiliateProgram[]
  redemptions RewardRedemption[]

  @@map("affiliates")
}

model AffiliateProgram {
  affiliateId String
  programId   String
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([affiliateId, programId])
  @@map("affiliate_programs")
}

model AffiliateClick {
  id          String    @id @default(uuid())
  affiliateId String
  ip          String?
  userAgent   String?
  referrer    String?
  createdAt   DateTime  @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@map("affiliate_clicks")
}

model Commission {
  id          String           @id @default(uuid())
  affiliateId String
  paymentId   String           @unique
  amount      Decimal          @db.Decimal(15, 2)
  status      CommissionStatus @default(PENDING)
  approvedAt  DateTime?
  approvedBy  String?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])
  payment   Payment   @relation(fields: [paymentId], references: [id])

  @@map("commissions")
}

model Withdrawal {
  id             String           @id @default(uuid())
  affiliateId    String
  amount         Decimal          @db.Decimal(15, 2)
  status         WithdrawalStatus @default(PENDING)
  bankName       String
  bankAccount    String
  bankHolder     String
  notes          String?
  processedAt    DateTime?
  processedBy    String?
  rejectedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@map("withdrawals")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  position  String?
  content   String   @db.Text
  photoUrl  String?
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model FollowUpCategory {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  icon        String?
  color       String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  templates   FollowUpTemplate[]

  @@map("follow_up_categories")
}

model FollowUpTemplate {
  id              String             @id @default(uuid())
  categoryId      String
  name            String
  subject         String?
  message         String             @db.Text
  channel         String             @default("WHATSAPP") // WHATSAPP or EMAIL
  placeholders    String?            @db.Text // comma-separated list of available placeholders
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  category        FollowUpCategory   @relation(fields: [categoryId], references: [id])
  logs            FollowUpLog[]

  @@map("follow_up_templates")
}

model FollowUpLog {
  id              String             @id @default(uuid())
  templateId      String
  candidateId     String
  channel         String             @default("WHATSAPP")
  to              String
  message         String             @db.Text
  status          String             @default("SENT") // SENT, FAILED
  errorMessage    String?
  sentAt          DateTime           @default(now())
  createdAt       DateTime           @default(now())

  template        FollowUpTemplate   @relation(fields: [templateId], references: [id])
  candidate       Candidate          @relation(fields: [candidateId], references: [id])

  @@map("follow_up_logs")
}

model Reward {
  id              String   @id @default(uuid())
  name            String
  description     String   @db.Text
  image           String?
  pointsRequired  Int
  stock           Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  id          String   @id @default(uuid())
  affiliateId String
  rewardId    String
  pointsSpent Int
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  reward      Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@map("reward_redemptions")
}

enum FormType {
  REGISTER
  AFFILIATE
}

model FormSetting {
  id         String    @id @default(uuid())
  title      String
  formType   FormType  @default(REGISTER)
  programIds Json?
  template   String    @default("default")
  fields     Json
  slug       String    @unique
  isActive   Boolean   @default(true)
  ocrEnabled Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("form_settings")
}

enum MemberAreaRole {
  OWNER
  ADMIN
  MEMBER
}

enum MemberAreaVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum PostType {
  ANNOUNCEMENT
  DISCUSSION
  SHARED_FILE
  POLL
}

model MemberAreaCategory {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  icon      String?
  color     String?
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  areas     MemberArea[]

  @@map("member_area_categories")
}

model MemberArea {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  description String?            @db.Text
  coverUrl    String?
  avatarUrl   String?
  categoryId  String?
  visibility  MemberAreaVisibility @default(PRIVATE)
  isActive    Boolean            @default(true)
  targetRole  Role?              // KANDIDAT, AFFILIATE, etc - who can join
  maxMembers  Int?
  settings    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  category    MemberAreaCategory? @relation(fields: [categoryId], references: [id])
  createdBy   String?
  members     MemberAreaMember[]
  posts       MemberAreaPost[]
  files       MemberAreaFile[]

  @@map("member_areas")
}

model MemberAreaMember {
  id        String        @id @default(uuid())
  areaId    String
  userId    String
  role      MemberAreaRole @default(MEMBER)
  joinedAt  DateTime      @default(now())
  isActive  Boolean       @default(true)
  invitedBy String?

  area      MemberArea    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user      User          @relation("MemberAreaMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter   User?         @relation("MemberAreaMemberInviter", fields: [invitedBy], references: [id])

  @@unique([areaId, userId])
  @@map("member_area_members")
}

model MemberAreaPost {
  id        String    @id @default(uuid())
  areaId    String
  userId    String
  title     String
  content   String    @db.Text
  type      PostType  @default(DISCUSSION)
  isPinned  Boolean   @default(false)
  isLocked  Boolean   @default(false)
  tags      String?   @db.Text // comma-separated
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  area      MemberArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])
  comments  MemberAreaComment[]
  reactions MemberAreaReaction[]
  files     MemberAreaFile[]

  @@map("member_area_posts")
}

model MemberAreaComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String   @db.Text
  parentId  String?  // for nested replies
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      MemberAreaPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])
  parent    MemberAreaComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   MemberAreaComment[] @relation("CommentReplies")

  @@map("member_area_comments")
}

model MemberAreaReaction {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  emoji     String   @default("👍") // 👍 ❤️ 😂 😮 😢 🔥
  createdAt DateTime @default(now())

  post      MemberAreaPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@map("member_area_reactions")
}

model MemberAreaFile {
  id        String   @id @default(uuid())
  areaId    String?
  postId    String?
  userId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  area      MemberArea? @relation(fields: [areaId], references: [id], onDelete: Cascade)
  post      MemberAreaPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  user      User        @relation(fields: [userId], references: [id])

  @@map("member_area_files")
}

// ── LMS (Learning Management System) ──

enum AssignmentStatus {
  BELUM_MENGUMPULKAN
  MENUNGGU_DINILAI
  DINILAI
}

model Course {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  coverUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]

  @@map("courses")
}

model CourseModule {
  id        String   @id @default(uuid())
  courseId   String
  title     String
  description String? @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons    CourseLesson[]
  assignments CourseAssignment[]

  @@map("course_modules")
}

model CourseLesson {
  id        String   @id @default(uuid())
  moduleId  String
  title     String
  content   String?  @db.LongText
  videoUrl  String?
  duration  Int?     // in minutes
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials  CourseMaterial[]

  @@map("course_lessons")
}

model CourseMaterial {
  id        String   @id @default(uuid())
  lessonId  String
  title     String
  fileUrl   String
  fileType  String   @default("FILE") // FILE, VIDEO, LINK, EMBED
  fileSize  Int?
  createdAt DateTime @default(now())

  lesson     CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("course_materials")
}

model CourseAssignment {
  id          String           @id @default(uuid())
  moduleId    String
  title       String
  description String?          @db.Text
  maxScore    Int              @default(100)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@map("course_assignments")
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  courseId   String
  userId    String
  teacherId String?  // GURU assigned to this student for this course
  status    String   @default("AKTIF") // AKTIF, SELESAI, KELUAR
  enrolledAt DateTime @default(now())
  completedAt DateTime?

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher    User?    @relation("GuruEnrollment", fields: [teacherId], references: [id])
  submissions AssignmentSubmission[]

  @@unique([courseId, userId])
  @@map("course_enrollments")
}

model AssignmentSubmission {
  id             String           @id @default(uuid())
  assignmentId   String
  enrollmentId   String
  content        String?          @db.Text
  fileUrl        String?
  score          Int?
  feedback       String?          @db.Text
  status         AssignmentStatus @default(BELUM_MENGUMPULKAN)
  submittedAt    DateTime?
  gradedAt       DateTime?
  gradedBy       String?

  assignment     CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  enrollment     CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  grader         User?            @relation("GradedBy", fields: [gradedBy], references: [id])

  @@unique([assignmentId, enrollmentId])
  @@map("assignment_submissions")
}
